# Copy to .env before running `docker compose up`:  cp .env.example .env

# PostgreSQL (database name / user / password)
POSTGRES_DB=tradingapp
POSTGRES_USER=db-user
POSTGRES_PASSWORD=db-p@$$w0rd

# Backend JWT signing secret - must be at least 32 characters. Change for anything non-local.
APP_JWT_SECRET=local-dev-secret-please-change-0123456789-abcdefghij
